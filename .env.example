# Copy to .env.local for local development (npm run db:start, then fill from
# `npx supabase status`). On Vercel, set these per environment instead.
#
# VITE_* values are embedded in the public JavaScript. Never put a secret in a
# VITE_* variable — `npm run build` refuses to build if it looks like one.

# Public (browser)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare test key that always passes (use the real site key in production)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_VOICE_ENABLED=true

# Server only (Vercel Functions)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=sb_secret_...
# Cloudflare test secret that always passes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Random 32+ byte hex string, different per environment: openssl rand -hex 32
IP_HASH_SALT=
