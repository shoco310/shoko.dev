{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/p/profile.html"
    },
    {
      "source": "/vision",
      "destination": "/p/vision.html"
    },
    {
      "source": "/policies",
      "destination": "/p/policies.html"
    },
    {
      "source": "/research",
      "destination": "/p/research.html"
    },
    {
      "source": "/data",
      "destination": "/p/data.html"
    },
    {
      "source": "/activity",
      "destination": "/p/activity.html"
    },
    {
      "source": "/about",
      "destination": "/p/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/p/privacy.html"
    },
    {
      "source": "/voice",
      "destination": "/p/voice.html"
    },
    {
      "source": "/join",
      "destination": "/p/join.html"
    },
    {
      "source": "/issues",
      "destination": "/p/issues.html"
    },
    {
      "source": "/changes",
      "destination": "/p/changes.html"
    },
    {
      "source": "/events",
      "destination": "/p/events.html"
    },
    {
      "source": "/policy",
      "destination": "/p/policies.html"
    },
    {
      "source": "/policy/education",
      "destination": "/p/policy/education.html"
    },
    {
      "source": "/policy/work",
      "destination": "/p/policy/work.html"
    },
    {
      "source": "/policy/childcare",
      "destination": "/p/policy/childcare.html"
    },
    {
      "source": "/policy/civic",
      "destination": "/p/policy/civic.html"
    },
    {
      "source": "/events/:slug([0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+)",
      "destination": "/p/app.html"
    },
    {
      "source": "/reports/:slug([0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+)",
      "destination": "/p/app.html"
    },
    {
      "source": "/issues/:id([1-9][0-9]{0,8})",
      "destination": "/p/app.html"
    }
  ],
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://assets.st-note.com https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
